# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — NEVER commit secrets.

# ============================================
# Supabase
# ============================================
# Get these from your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================
# Razorpay
# ============================================
# Get these from Razorpay dashboard: Settings → API Keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# ============================================
# MSG91 (Phone OTP)
# ============================================
MSG91_AUTH_KEY=your-msg91-auth-key
MSG91_TEMPLATE_ID=your-otp-template-id
MSG91_SENDER_ID=your-sender-id

# ============================================
# Cloudinary (Image uploads)
# ============================================
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your-unsigned-preset
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ============================================
# Mapbox (Address autocomplete + map — Step 3 of lender form)
# ============================================
# Sign up at mapbox.com — free tier (50k loads/month) covers MVP.
# Restrict the token to your allowed URLs in the Mapbox dashboard.
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-public-token

# ============================================
# Auth session signing
# ============================================
# Pepper used to derive deterministic Supabase Auth passwords from phone numbers.
# Must never change after first user signs up — changing it breaks all existing sessions.
# Generate: openssl rand -hex 32
SUPABASE_PHONE_PASSWORD_SECRET=your-32-char-random-secret-here

# ============================================
# App config
# ============================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=BrandName

# ============================================
# Vercel Edge Config (emergency lockdown + feature flags)
# ============================================
# See docs/SETUP.md § Vercel Edge Config for setup instructions.
# EDGE_CONFIG is auto-populated when you connect the store in Vercel project settings.
EDGE_CONFIG=https://edge-config.vercel.com/ecfg_xxx?token=yyy
EDGE_CONFIG_ID=ecfg_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Personal access token with Full Account scope — used to write Edge Config items.
VERCEL_ACCESS_TOKEN=your-vercel-access-token

# ============================================
# Firebase (Push notifications via FCM)
# ============================================
# Get client config from Firebase console: Project Settings → General → Your apps → Web app
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id
# VAPID key from: Project Settings → Cloud Messaging → Web Push Certificates → Generate key pair
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your-vapid-key
# Service account JSON for server-side FCM sends: Project Settings → Service Accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# ============================================
# Dev bypass
# ============================================
# Set to "true" to accept any OTP without MSG91 verification (dev only — never set in production)
OTP_BYPASS=

# ============================================
# Internal secrets
# ============================================
LIFECYCLE_SWEEP_SECRET=your-lifecycle-sweep-secret
